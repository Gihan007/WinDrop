<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package manifest. __VERSION__ is filled in by the build (e.g. 1.2.0.0). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop2 rescap">

  <Identity
    Name="Gihan.WinDropX"
    Publisher="CN=C6DDABAA-0B5C-4C9B-BA9D-72148E68EEA5"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>WinDropX</DisplayName>
    <PublisherDisplayName>Gihan</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Send photos, videos and files between your iPhone and this PC over Wi-Fi.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="WinDropX" Executable="WinDrop\WinDrop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="WinDropX"
        Description="Send photos, videos and files between your iPhone and this PC over Wi-Fi."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <!-- Package-level extension: lets the phone reach the app on the local network without any firewall prompt. -->
  <Extensions>
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="WinDrop\WinDrop.exe">
        <desktop2:Rule Direction="in" IPProtocol="TCP" Profile="all" LocalPortMin="8765" LocalPortMax="8775" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>
</Package>
